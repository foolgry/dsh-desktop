{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "description": "Desktop shell for DeepSeek Harness: downloads as an installer, runs the dsh web UI with Electron's embedded Node — no system Node or npm required.",
  "version": "0.1.0-rc.6.5",
  "private": true,
  "author": "foolgry",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "pack": "tsc && electron-builder",
    "dist:mac": "tsc && electron-builder --mac",
    "dist:win": "tsc && electron-builder --win"
  },
  "dsh": {
    "upstream": "@deepseek-ai/dsh",
    "upstreamVersion": "0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "semver": "^7.7.1",
    "typescript": "^5.8.3"
  }
}
